<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>NostalgicRellm</AssemblyName>
    <RootNamespace>NostalgicRellm</RootNamespace>
    <Version>0.3.3</Version>

    <!-- Leveza: GC de estação de trabalho sem thread de fundo extra -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredCompilationQuickStartForLoops>true</TieredCompilationQuickStartForLoops>

    <!-- Publicação como exe único portátil -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <!-- Versão completa (com o .NET embutido): comprime para não passar de ~50 MB -->
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- Skins padrão embutidas; extraídas para ./skins na primeira execução -->
    <EmbeddedResource Include="skins\**\*" LogicalName="skins/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Traduções embutidas; um ./lang/<código>.json ao lado do exe tem prioridade -->
    <EmbeddedResource Include="lang\*.json" LogicalName="lang/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
